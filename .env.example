# Netlify/Supabase admin access. When both values are present, all /api/* routes
# (except /api/auth/config) require a Supabase access token.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# GitHub Pages publishing target used by the admin Publish button.
# Token needs contents:write access to the target repo.
GITHUB_PAGES_REPO=owner/repository
GITHUB_PAGES_BRANCH=gh-pages
GITHUB_PAGES_PATH=
GITHUB_PAGES_TOKEN=github_pat_or_fine_grained_token
GITHUB_COMMITTER_NAME=Results Marketing CMS
GITHUB_COMMITTER_EMAIL=cms@example.com

# Optional local render output before uploading to GitHub.
PUBLISH_LOCAL_DIR=published
